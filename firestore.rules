rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Classified case files: any signed-in member can read; nobody can write from the site.
    // Add or edit files in the Firebase console instead.
    match /casefiles/{fileId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
